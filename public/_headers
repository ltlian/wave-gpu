# Cross-origin isolation is what gives the capture worklet a real SharedArrayBuffer
# ring (without it the worklet falls back to postMessage). The headers have to be on
# the HTML document and on its module scripts alike, hence `/*`.
#
# NOTE: a response generated by Worker *code* would not inherit these — this site is
# assets-only precisely so it does not need a Worker script at all.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Vite emits content-hashed filenames, so these can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The synthesized loop never changes between builds without a new deploy; a short
# max-age keeps it cheap while still replacing it on the next visit after one.
/audio/*
  Cache-Control: public, max-age=3600

# 4.6 MB of raw PCM: never worth keeping in the HTTP cache.
/stream/pcm
  Cache-Control: no-store

/api/*
  Cache-Control: no-store
