{
  "name": "wave-gpu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Play audio in the browser and read the same samples to drive a WebGPU waveform.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:audio",
    "build:audio": "node scripts/build-audio.ts",
    "preview": "vite preview",
    "preview:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
}
